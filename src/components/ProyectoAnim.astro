---
// Vista previa animada para tarjetas de proyecto sin foto todavía.
// Cada variante representa el tipo de sistema con CSS puro (sin JS).
// Cuando el proyecto tenga captura real, esta animación se reemplaza sola.
import type { Anim } from "../data/proyectos";

interface Props {
  variant: Anim;
}

const { variant } = Astro.props;
---

<div class="anim" aria-hidden="true">
  {
    variant === "energia" && (
      <div class="energia">
        <span class="bar teal" style="--d:0s; --h:70%" />
        <span class="bar teal" style="--d:0.3s; --h:45%" />
        <span class="bar amber" style="--d:0.6s; --h:90%" />
        <span class="bar teal" style="--d:0.9s; --h:55%" />
        <span class="bar teal" style="--d:1.2s; --h:75%" />
        <span class="bar amber" style="--d:1.5s; --h:40%" />
        <span class="bar teal" style="--d:1.8s; --h:62%" />
      </div>
    )
  }

  {
    variant === "chat" && (
      <div class="chat">
        <span class="burbuja entrante" style="--d:0s">
          Hola, ¿tienen cita hoy?
        </span>
        <span class="burbuja saliente" style="--d:1.6s">
          Sí ✓ 3:00 PM disponible
        </span>
        <span class="burbuja escribiendo" style="--d:3.2s">
          <i style="--d:0s" />
          <i style="--d:0.2s" />
          <i style="--d:0.4s" />
        </span>
      </div>
    )
  }

  {
    variant === "inventario" && (
      <div class="inventario">
        {Array.from({ length: 12 }).map((_, i) => (
          <span class="celda" style={`--d:${(i * 0.35).toFixed(2)}s`} />
        ))}
      </div>
    )
  }

  {
    variant === "solar" && (
      <div class="solar">
        <span class="sol" />
        <div class="paneles">
          <span class="panel" style="--d:0s" />
          <span class="panel" style="--d:0.5s" />
          <span class="panel" style="--d:1s" />
        </div>
      </div>
    )
  }

  {
    variant === "catalogo" && (
      <div class="catalogo">
        <div class="carrusel">
          {Array.from({ length: 8 }).map((_, i) => (
            <span class:list={["producto", i % 4 === 1 && "activo"]}>
              <i class="foto" />
              <i class="linea" />
              <i class="linea corta" />
            </span>
          ))}
        </div>
      </div>
    )
  }

  {
    variant === "datos" && (
      <svg class="datos" viewBox="0 0 320 120" preserveAspectRatio="none">
        <polyline
          class="serie teal-line"
          points="0,90 40,70 80,80 120,45 160,60 200,30 240,42 280,18 320,28"
          fill="none"
        />
        <polyline
          class="serie amber-line"
          points="0,100 40,92 80,95 120,75 160,82 200,62 240,70 280,50 320,55"
          fill="none"
        />
      </svg>
    )
  }

  {
    variant === "factura" && (
      <div class="factura">
        <p class="fx-head">FACTURA-E · XML UBL</p>
        {["ACETAMINOFÉN 500MG", "IBUPROFENO 400MG", "LORATADINA 10MG"].map((item, i) => (
          <p class="fx-linea" style={`--d:${(i * 0.7).toFixed(1)}s`}>
            <span>{item}</span>
            <b>LOTE ✓</b>
          </p>
        ))}
        <p class="fx-cuadre">CUADRE A·B·C ✓</p>
      </div>
    )
  }

  {
    variant === "ocr" && (
      <div class="ocr">
        <div class="display-lcd">
          <span class="lectura">230.4</span>
          <span class="unidad">V AC</span>
          <i class="esquina tl" />
          <i class="esquina tr" />
          <i class="esquina bl" />
          <i class="esquina br" />
          <i class="scan" />
        </div>
        <p class="ocr-out">→ COM-F-05 · CELDA D14 = 230.4</p>
      </div>
    )
  }

  {
    variant === "forecast" && (
      <svg class="forecast" viewBox="0 0 320 120" preserveAspectRatio="none">
        <line class="cero" x1="0" y1="70" x2="320" y2="70" />
        <polyline
          class="historia"
          points="0,40 20,42 40,46 60,58 80,82 100,98 120,96 140,80 160,52 180,38"
          fill="none"
        />
        <polyline
          class="prediccion"
          points="180,38 200,40 220,46 240,60 260,84 280,100 300,95 320,78"
          fill="none"
        />
        <line class="ahora" x1="180" y1="6" x2="180" y2="114" />
      </svg>
    )
  }

  <span class="lbl">[ SIMULACIÓN ]</span>
</div>

<style>
  .anim {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 10%, transparent);
    background-color: #0a0f19;
    background-image:
      linear-gradient(rgba(62, 207, 184, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(62, 207, 184, 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .lbl {
    position: absolute;
    right: 10px;
    bottom: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--color-fog) 55%, transparent);
  }

  /* ---------- energía: barras de consumo ---------- */
  .energia {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    height: 58%;
    border-bottom: 1px solid color-mix(in srgb, var(--color-fog) 30%, transparent);
    padding: 0 4px;
  }

  .bar {
    width: 14px;
    height: var(--h);
    border-radius: 2px 2px 0 0;
    transform-origin: bottom;
    animation: medir 2.4s ease-in-out var(--d) infinite;
  }

  .bar.teal { background: color-mix(in srgb, var(--color-teal) 75%, transparent); }
  .bar.amber { background: color-mix(in srgb, var(--color-amber) 80%, transparent); }

  @keyframes medir {
    0%, 100% { transform: scaleY(0.45); }
    50% { transform: scaleY(1); }
  }

  /* ---------- chat: conversación del bot ---------- */
  .chat {
    display: flex;
    flex-direction: column;
    gap: 9px;
    width: 62%;
  }

  .burbuja {
    max-width: 78%;
    padding: 6px 11px;
    border-radius: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    opacity: 0;
    animation: llegar 6.5s ease var(--d) infinite;
  }

  .burbuja.entrante {
    align-self: flex-start;
    background: var(--color-panel);
    border: 1px solid color-mix(in srgb, var(--color-fog) 25%, transparent);
    color: var(--color-paper);
    border-bottom-left-radius: 2px;
  }

  .burbuja.saliente {
    align-self: flex-end;
    border: 1px solid color-mix(in srgb, var(--color-teal) 45%, transparent);
    background: color-mix(in srgb, var(--color-teal) 10%, transparent);
    color: var(--color-teal);
    border-bottom-right-radius: 2px;
  }

  .burbuja.escribiendo {
    align-self: flex-start;
    background: var(--color-panel);
    border: 1px solid color-mix(in srgb, var(--color-fog) 25%, transparent);
    border-bottom-left-radius: 2px;
    display: inline-flex;
    gap: 4px;
    padding: 9px 11px;
  }

  .burbuja.escribiendo i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-fog);
    animation: teclear 1s ease var(--d) infinite;
  }

  @keyframes llegar {
    0%, 8% { opacity: 0; transform: translateY(6px); }
    16%, 82% { opacity: 1; transform: none; }
    92%, 100% { opacity: 0; transform: translateY(-4px); }
  }

  @keyframes teclear {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }

  /* ---------- inventario: celdas de stock ---------- */
  .inventario {
    display: grid;
    grid-template-columns: repeat(4, 34px);
    gap: 8px;
  }

  .celda {
    height: 24px;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--color-fog) 30%, transparent);
    animation: existencia 4.2s ease var(--d) infinite;
  }

  @keyframes existencia {
    0%, 100% { background: transparent; border-color: color-mix(in srgb, var(--color-fog) 30%, transparent); }
    35%, 70% { background: color-mix(in srgb, var(--color-teal) 30%, transparent); border-color: color-mix(in srgb, var(--color-teal) 60%, transparent); }
  }

  /* ---------- solar: sol + paneles cargando ---------- */
  .solar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .sol {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-amber);
    animation: brillar 2.8s ease-in-out infinite;
  }

  @keyframes brillar {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-amber) 35%, transparent); }
    50% { box-shadow: 0 0 0 14px transparent; }
  }

  .paneles {
    display: flex;
    gap: 8px;
  }

  .panel {
    position: relative;
    width: 52px;
    height: 10px;
    border: 1px solid color-mix(in srgb, var(--color-teal) 45%, transparent);
    border-radius: 2px;
    overflow: hidden;
  }

  .panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-teal) 55%, transparent);
    transform-origin: left;
    animation: cargar 3s ease var(--d) infinite;
  }

  @keyframes cargar {
    0% { transform: scaleX(0); }
    70%, 100% { transform: scaleX(1); }
  }

  /* ---------- catálogo: carrusel de productos ---------- */
  .catalogo {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent);
  }

  .carrusel {
    display: flex;
    gap: 14px;
    width: max-content;
    padding: 0 7px;
    animation: pasar 12s linear infinite;
  }

  .producto {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 64px;
    padding: 6px;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--color-fog) 28%, transparent);
    background: var(--color-panel);
  }

  .producto.activo {
    border-color: color-mix(in srgb, var(--color-amber) 60%, transparent);
  }

  .producto .foto {
    height: 34px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-teal) 14%, transparent);
  }

  .producto.activo .foto {
    background: color-mix(in srgb, var(--color-amber) 18%, transparent);
  }

  .producto .linea {
    height: 4px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-fog) 45%, transparent);
  }

  .producto .linea.corta { width: 60%; }

  @keyframes pasar {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ---------- datos: series dibujándose ---------- */
  .datos {
    width: 78%;
    height: 62%;
  }

  .serie {
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: trazar 5s ease-in-out infinite;
  }

  .teal-line { stroke: var(--color-teal); }

  .amber-line {
    stroke: color-mix(in srgb, var(--color-amber) 85%, transparent);
    animation-delay: 0.6s;
  }

  @keyframes trazar {
    0% { stroke-dashoffset: 600; }
    45%, 80% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -600; }
  }

  /* ---------- factura: líneas leídas y cuadradas ---------- */
  .factura {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 64%;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .factura p { margin: 0; }

  .fx-head { color: var(--color-fog); }

  .fx-linea {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 5px 8px;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--color-fog) 25%, transparent);
    color: var(--color-paper);
    animation: leer 5s ease var(--d) infinite;
  }

  .fx-linea b {
    font-weight: 600;
    color: var(--color-teal);
    opacity: 0;
    animation: aprobar 5s ease var(--d) infinite;
  }

  .fx-cuadre {
    align-self: flex-end;
    padding: 3px 8px;
    border-radius: 3px;
    color: var(--color-ink);
    background: var(--color-amber);
    font-weight: 600;
    opacity: 0;
    animation: aprobar 5s ease 2.2s infinite;
  }

  @keyframes leer {
    0%, 8% { border-color: color-mix(in srgb, var(--color-fog) 25%, transparent); }
    18%, 85% { border-color: color-mix(in srgb, var(--color-teal) 55%, transparent); }
    100% { border-color: color-mix(in srgb, var(--color-fog) 25%, transparent); }
  }

  @keyframes aprobar {
    0%, 15% { opacity: 0; }
    25%, 85% { opacity: 1; }
    95%, 100% { opacity: 0; }
  }

  /* ---------- ocr: lectura del multímetro ---------- */
  .ocr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .display-lcd {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-teal) 8%, #0a0f19);
    overflow: hidden;
  }

  .lectura {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 600;
    color: var(--color-paper);
    letter-spacing: 0.04em;
  }

  .unidad {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-fog);
  }

  .esquina {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: var(--color-amber);
    border-style: solid;
    border-width: 0;
  }
  .esquina.tl { top: 3px; left: 3px; border-top-width: 2px; border-left-width: 2px; }
  .esquina.tr { top: 3px; right: 3px; border-top-width: 2px; border-right-width: 2px; }
  .esquina.bl { bottom: 3px; left: 3px; border-bottom-width: 2px; border-left-width: 2px; }
  .esquina.br { bottom: 3px; right: 3px; border-bottom-width: 2px; border-right-width: 2px; }

  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--color-teal);
    box-shadow: 0 0 10px var(--color-teal);
    animation: escanear 2.4s ease-in-out infinite;
  }

  @keyframes escanear {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(58px); }
  }

  .ocr-out {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--color-teal);
    animation: aprobar 4.8s ease 0.6s infinite;
  }

  /* ---------- forecast: histórico + predicción ---------- */
  .forecast {
    width: 80%;
    height: 64%;
    overflow: visible;
  }

  .forecast .cero {
    stroke: color-mix(in srgb, var(--color-fog) 35%, transparent);
    stroke-width: 1;
  }

  .forecast .historia {
    stroke: var(--color-teal);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .forecast .prediccion {
    stroke: var(--color-amber);
    stroke-width: 2;
    stroke-dasharray: 6 5;
    stroke-linejoin: round;
    animation: predecir 1.2s linear infinite;
  }

  .forecast .ahora {
    stroke: color-mix(in srgb, var(--color-paper) 40%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }

  @keyframes predecir {
    to { stroke-dashoffset: -22; }
  }

  /* ---------- movimiento reducido: cuadro estático ---------- */
  @media (prefers-reduced-motion: reduce) {
    .fx-linea { animation: none; }
    .fx-linea b, .fx-cuadre, .ocr-out { animation: none; opacity: 1; }
    .scan { animation: none; opacity: 0; }
    .forecast .prediccion { animation: none; }
    .bar { animation: none; }
    .burbuja { animation: none; opacity: 1; }
    .burbuja.escribiendo i { animation: none; opacity: 0.6; }
    .celda { animation: none; }
    .celda:nth-child(-n + 7) {
      background: color-mix(in srgb, var(--color-teal) 30%, transparent);
      border-color: color-mix(in srgb, var(--color-teal) 60%, transparent);
    }
    .sol { animation: none; }
    .panel::after { animation: none; transform: scaleX(0.7); }
    .carrusel { animation: none; }
    .serie { animation: none; stroke-dashoffset: 0; }
  }
</style>
