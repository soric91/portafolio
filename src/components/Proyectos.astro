---
import { SITE, repoUrl } from "../config";
import { CATEGORIAS, proyectos, laboratorio, type Categoria } from "../data/proyectos";
import ProyectoAnim from "./ProyectoAnim.astro";

// Prefijo del despliegue (ej. "/portafolio" en GitHub Pages)
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const filtros = [
  { id: "todos", label: "Todos", total: proyectos.length },
  ...(Object.entries(CATEGORIAS) as [Categoria, string][]).map(([id, label]) => ({
    id,
    label,
    total: proyectos.filter((p) => p.cat === id).length,
  })),
].filter((f) => f.total > 0);
---

<section id="proyectos" class="mx-auto max-w-6xl px-5 py-20 md:py-24">
  <p class="tag reveal">[ 03 / PROYECTOS ]</p>
  <div class="mt-3 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h2 class="display reveal max-w-2xl text-4xl [font-stretch:122%] md:text-[40px]">
        Más sistemas en marcha
      </h2>
      <p class="reveal mt-5 max-w-xl text-fog">
        Software para droguerías, técnicos en campo, empresas solares y
        negocios que venden por WhatsApp. Algunos ya los usan clientes todos
        los días.
      </p>
    </div>

    <div class="reveal flex flex-wrap gap-2" role="group" aria-label="Filtrar proyectos por categoría">
      {
        filtros.map((f, i) => (
          <button
            type="button"
            class="chip"
            data-filtro={f.id}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {f.label}
            <span class="font-mono text-[10px] opacity-70">{f.total}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {
      proyectos.map((p) => (
        <article
          data-cat={p.cat}
          class="tarjeta reveal flex flex-col overflow-hidden rounded-md border border-paper/10 bg-panel/60"
        >
          <header class="flex items-center justify-between gap-3 border-b border-paper/10 px-5 py-3 font-mono text-[11px] tracking-[0.12em] text-fog">
            <span>{p.code}</span>
            <span class="truncate text-teal">{p.tipo}</span>
          </header>

          <div class="relative">
            {p.img ? (
              <img
                src={`${base}${p.img}`}
                alt={`Captura del proyecto ${p.nombre}`}
                loading="lazy"
                decoding="async"
                width="1600"
                height="900"
                class="aspect-video w-full border-b border-paper/10 object-cover"
              />
            ) : (
              <ProyectoAnim variant={p.anim} />
            )}
            {p.estado && (
              <span
                class:list={[
                  "estado absolute top-3 left-3 rounded-[3px] px-2 py-0.5 font-mono text-[10px] font-semibold tracking-[0.12em]",
                  p.estado === "PROTOTIPO" ? "is-proto" : "is-live",
                ]}
              >
                {p.estado !== "PROTOTIPO" && "● "}
                {p.estado}
              </span>
            )}
          </div>

          <div class="flex flex-1 flex-col gap-3 px-5 pt-5 pb-4">
            <h3 class="font-display text-[19px] leading-tight font-bold [font-stretch:115%]">
              {p.nombre}
            </h3>
            <p class="flex-1 text-sm leading-relaxed text-fog">{p.desc}</p>
            <ul class="flex flex-wrap gap-2">
              {p.stack.map((t) => (
                <li class="rounded-[3px] border border-teal/30 px-2 py-0.5 font-mono text-[11px] tracking-[0.06em] text-teal">
                  {t}
                </li>
              ))}
            </ul>
          </div>

          <footer class="flex items-center gap-5 border-t border-paper/10 px-5 py-3 font-mono text-[11px] tracking-[0.12em]">
            {p.repo && (
              <a
                href={repoUrl(p.repo)}
                target="_blank"
                rel="noopener"
                class="text-teal transition-colors hover:text-amber"
              >
                CÓDIGO ↗
              </a>
            )}
            {p.demo && (
              <a
                href={p.demo}
                target="_blank"
                rel="noopener"
                class="text-amber transition-colors hover:text-paper"
              >
                DEMO ↗
              </a>
            )}
            {!p.repo && !p.demo && (
              <span class="text-fog">CÓDIGO PRIVADO · DEMO A PEDIDO</span>
            )}
          </footer>
        </article>
      ))
    }
  </div>

  <!-- Laboratorio: herramientas pequeñas -->
  <div class="reveal mt-16">
    <p class="font-mono text-[11px] tracking-[0.14em] text-amber">LABORATORIO / HERRAMIENTAS PROPIAS</p>
    <ul class="lab mt-4 grid overflow-hidden rounded-md border border-paper/10 sm:grid-cols-2">
      {
        laboratorio.map((l) => (
          <li class="flex flex-col gap-1 bg-panel/40 px-5 py-4">
            <span class="font-display text-[16px] font-bold [font-stretch:115%]">{l.nombre}</span>
            <span class="text-sm text-fog">{l.desc}</span>
            <span class="font-mono text-[11px] tracking-[0.04em] text-teal">{l.stack}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="reveal mt-8 font-mono text-xs tracking-[0.08em] text-fog">
    MÁS CÓDIGO EN{" "}
    <a
      href={SITE.github}
      target="_blank"
      rel="noopener"
      class="text-teal transition-colors hover:text-amber"
    >
      GITHUB ↗
    </a>
  </p>
</section>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--color-paper) 14%, transparent);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--color-fog);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
    cursor: pointer;
  }
  .chip:hover {
    color: var(--color-paper);
    border-color: color-mix(in srgb, var(--color-teal) 50%, transparent);
  }
  .chip[aria-pressed="true"] {
    color: var(--color-ink);
    background: var(--color-teal);
    border-color: var(--color-teal);
  }

  .tarjeta {
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease, opacity 0.6s ease;
  }
  .tarjeta:hover {
    border-color: color-mix(in srgb, var(--color-amber) 50%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -24px rgba(255, 178, 36, 0.35);
  }
  .tarjeta[hidden] {
    display: none;
  }

  /* separadores de la rejilla del laboratorio: 1 columna en móvil, 2 en sm+ */
  .lab {
    gap: 1px;
    background: color-mix(in srgb, var(--color-paper) 10%, transparent);
  }
  .lab li {
    background: var(--color-ink);
  }

  .estado {
    backdrop-filter: blur(6px);
    background: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }
  .estado.is-live {
    color: var(--color-teal);
    border: 1px solid color-mix(in srgb, var(--color-teal) 45%, transparent);
  }
  .estado.is-proto {
    color: var(--color-amber);
    border: 1px solid color-mix(in srgb, var(--color-amber) 45%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta,
    .tarjeta:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>("#proyectos [data-filtro]");
  const tarjetas = document.querySelectorAll<HTMLElement>("#proyectos [data-cat]");

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const filtro = chip.dataset.filtro;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      tarjetas.forEach((t) => {
        t.hidden = filtro !== "todos" && t.dataset.cat !== filtro;
        // las tarjetas que reaparecen no deben quedar invisibles por el reveal
        t.classList.add("is-visible");
      });
    })
  );
</script>
