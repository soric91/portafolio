---
import { whatsappUrl } from "../config";
import HeroGaleria from "./HeroGaleria.astro";
---

<section class="mx-auto max-w-6xl px-5 pt-12 md:pt-16">
  <div class="grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
    <div>
      <h1 class="display text-[clamp(44px,6vw,76px)]">
        Del problema<br />a la solución.
      </h1>

      <p class="mt-7 max-w-xl text-xl leading-relaxed text-fog">
        Su negocio tiene procesos lentos, datos dispersos o tareas que se
        hacen a mano. Yo los convierto en plataformas web, APIs,
        automatización con IA y tableros en tiempo real: menos trabajo
        manual, menos errores, más control.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href={whatsappUrl()}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 rounded bg-amber px-7 py-4 font-mono text-sm font-semibold tracking-[0.06em] text-ink transition-colors hover:bg-paper"
        >
          ▸ HABLEMOS POR WHATSAPP
        </a>
        <a
          href="#proyectos"
          class="inline-flex items-center gap-2.5 rounded border border-teal/40 px-7 py-4 font-mono text-sm tracking-[0.06em] text-teal transition-colors hover:border-teal hover:bg-teal/10"
        >
          VER PROYECTOS
        </a>
      </div>
    </div>

    <!-- Galería: lo que se entrega, de un vistazo -->
    <div class="w-full max-w-[640px] justify-self-center lg:justify-self-end">
      <HeroGaleria />
    </div>
  </div>

  <!-- Osciloscopio: el portafolio monitorea su propia señal -->
  <div class="mt-12 overflow-hidden rounded-md border border-teal/20 bg-[#0a0f19]/70 md:mt-16">
    <div
      class="flex items-center justify-between border-b border-teal/15 px-4 py-2.5 font-mono text-[11px] tracking-[0.12em] text-fog"
    >
      <span>SEÑAL / MONITOR-01</span>
      <span class="text-teal">● EN VIVO</span>
    </div>
    <canvas id="scope-canvas" class="block h-[180px] w-full" aria-hidden="true"
    ></canvas>
  </div>
</section>

<script>
  // Osciloscopio del hero: dos ondas compuestas sobre rejilla, en canvas.
  const canvas = document.getElementById("scope-canvas") as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let t = reduced ? 1.5 : 0;
    let raf: number | null = null;

    const draw = () => {
      const dpr = window.devicePixelRatio || 1;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      if (canvas.width !== w * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      // rejilla
      ctx.strokeStyle = "rgba(62,207,184,0.08)";
      ctx.lineWidth = 1;
      for (let x = 0; x < w; x += 32) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }
      for (let y = 0; y < h; y += 32) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      const mid = h / 2;
      const wave = (
        color: string,
        amp: number,
        freq: number,
        phase: number,
        glow: number
      ) => {
        ctx.beginPath();
        for (let x = 0; x <= w; x += 2) {
          const n =
            Math.sin(x * freq + t * 2 + phase) * amp +
            Math.sin(x * freq * 2.7 + t * 3.1 + phase) * amp * 0.35 +
            Math.sin(x * freq * 0.4 + t * 1.3) * amp * 0.5;
          const y = mid + n;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.shadowColor = color;
        ctx.shadowBlur = glow;
        ctx.stroke();
        ctx.shadowBlur = 0;
      };

      wave("#3ecfb8", 26, 0.018, 0, 12);
      wave("rgba(255,178,36,0.85)", 14, 0.011, 2.2, 8);
    };

    if (reduced) {
      // un solo cuadro estático; se redibuja si cambia el tamaño
      draw();
      window.addEventListener("resize", draw);
    } else {
      const loop = () => {
        if (!canvas.isConnected) {
          raf = null;
          return;
        }
        t += 0.02;
        draw();
        raf = requestAnimationFrame(loop);
      };
      raf = requestAnimationFrame(loop);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden && raf) {
          cancelAnimationFrame(raf);
          raf = null;
        } else if (!document.hidden && !raf) {
          raf = requestAnimationFrame(loop);
        }
      });
    }
  }
</script>
